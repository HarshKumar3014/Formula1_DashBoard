# Copy to api/.env for local dev (gitignored). On Render set these as environment variables.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Connect → "Session pooler" connection string (IPv4-friendly, works from Render).
# Leave unset locally to keep using SQLite in data/predictions.db.
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Publisher only (python -m app.publish, GitHub Actions): Supabase → Settings → API Keys →
# Secret key. Full access to the project — keep it out of the browser and out of git.
# SUPABASE_SECRET_KEY=sb_secret_...
