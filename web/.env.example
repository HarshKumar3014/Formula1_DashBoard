# Copy to web/.env.local for local dev (gitignored). On Vercel set these as environment variables.
NEXT_PUBLIC_API_URL=http://localhost:8020

# Supabase → Project Settings → API Keys → Project URL + publishable key (or legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
